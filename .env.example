PORT=8000
SECRET=12345678
WHITELIST=http://localhost:3000
MAX_SCRIPT_EXECUTION_TIME=30000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
CONTAINER_TERMINATION_SCHEDULE=10 # Scheduled Time to clear your container in minutes 1<=59

# Database connection pool configuration for autoscaling
# With multiple instances, configure connection_limit in DATABASE_URL to prevent pool exhaustion
# Example: DATABASE_URL="postgresql://...?connection_limit=8&pool_timeout=30"
# Recommended: (max_db_connections / max_instances) with some buffer
# Default Prisma pool size is 5 connections